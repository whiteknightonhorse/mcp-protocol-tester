# Target MCP server
MCP_SERVER_URL=https://your-server.com/mcp
API_BASE_URL=https://your-server.com
# leave empty for unauthenticated probing; set a key only for authenticated checks
API_KEY=

# x402 Payment (USDC on Base). Needed only when SKIP_PAYMENTS=false.
PRIVATE_KEY=

# Test configuration
CONCURRENCY=5
# set false to spend (see Cost column in docs/PHASES.md)
SKIP_PAYMENTS=true
# PHASES=0,1,2   # unset = all phases (ids: docs/PHASES.md)
MAX_TOOLS=0
TIMEOUT_MS=30000
MAX_USDC_BUDGET=0.25

# Each gates its own phase (P20/P25, P22, P23) and SKIPs cleanly if unset.
# Never set these to the same value as API_KEY above — moderation-trigger,
# balance-funding, and device probes are deliberately kept off the tester's
# own daily-use identity.
MODERATION_TEST_API_KEY=
BALANCE_RAIL_TEST_KEY=
DEVICE_TEST_API_KEY=
DEVICE_TEST_VENDOR=tuya

# P35 first-party shop purchase (cap $0.05/run). Spends only when SKIP_PAYMENTS=false AND E2E_SHOP_PAID=true.
# E2E_SHOP_PAID=true
# E2E_SHOP_SLUG=apibase-demo
# E2E_MERCHANT_KEY=   # reserved for the future shop.order.paid webhook card; no phase reads it today
